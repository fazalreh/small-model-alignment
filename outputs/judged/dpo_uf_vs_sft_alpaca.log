% Define the FEN notation for a standard chessboard
\newcommand{\fen}[1]{%
  \begin{fleqn}%
    \begin{array}{@{}c@{}}#1\\
      \hline
      \end{array}%
    \end{fleqn}%
}

\begin{document}

\section*{FEN Notation Chessboard}

