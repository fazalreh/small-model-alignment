```python
def fibonacci(n):
    # Base cases
    if n == 0:
        return 0
    elif n == 1:
        return 1

    # Initialize first two Fibonacci numbers
    fib = [0, 1]

    # Compute Fibonacci numbers iteratively
    for I in range(2, n+1):
        fib.append(fib[i-1] + fib[i-2])

    return fib[n]

# Test the function with example input
