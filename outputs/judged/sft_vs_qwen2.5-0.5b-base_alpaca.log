import data.list.basic
import tactic.timsort
variables {A : Type*} [decidable_eq A]
def timsort (a : A) : list A :=
let rec mergeSort (l : list A) (r : list A) : list A := do
match l with
| [] => r
| h :: tl =>
if h < r.head then
mergeSort tl (h :: r)
else
mergeSort (tl @ h :: l) r
end match
in mergeSort []
